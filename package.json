{
  "name": "galacticadventureproject",
  "version": "1.0.0",
  "description": "SAP CAP backend for the Galactic Spacefarer Adventure interview exercise",
  "private": true,
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "start": "cds serve",
    "watch": "cds watch",
    "test": "vitest run",
    "test:mailhog": "vitest run --config vitest.mailhog.config.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drendragon/GalacticAdventureProject.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Drendragon/GalacticAdventureProject/issues"
  },
  "homepage": "https://github.com/Drendragon/GalacticAdventureProject#readme",
  "type": "commonjs",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "cds": {
    "[development]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "basic",
          "users": {
            "earth-user": {
              "password": "earth-demo",
              "roles": [
                "SpacefarerUser"
              ],
              "attr": {
                "planet": "Earth"
              }
            },
            "earth-colleague": {
              "password": "earth-colleague-demo",
              "roles": [
                "SpacefarerUser"
              ],
              "attr": {
                "planet": "Earth"
              }
            },
            "mars-user": {
              "password": "mars-demo",
              "roles": [
                "SpacefarerUser"
              ],
              "attr": {
                "planet": "Mars"
              }
            },
            "planetless-user": {
              "password": "planetless-demo",
              "roles": [
                "SpacefarerUser"
              ]
            },
            "roleless-user": {
              "password": "roleless-demo",
              "attr": {
                "planet": "Earth"
              }
            },
            "*": false
          }
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": "jwt"
      }
    }
  },
  "dependencies": {
    "@cap-js/sqlite": "3.1.1",
    "@sap/cds": "10.1.1",
    "nodemailer": "10.0.11"
  },
  "devDependencies": {
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/cds-typer": "0.41.1",
    "@cap-js/cds-types": "0.20.0",
    "@sap/cds-dk": "10.1.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
